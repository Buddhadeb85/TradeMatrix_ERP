datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Business {
  id          Int          @id @default(autoincrement())
  name        String
  phone       String?
  address     String?
  gstin       String?
  createdAt   DateTime     @default(now())
  shopSetting ShopSetting?
  products    Product[]
  bills       Bill[]
  users       User[] // <--- Linked staff users for this business

  @@map("businesses")
}

model User {
  id           Int      @id @default(autoincrement())
  businessId   Int
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("CASHIER") // ADMIN, MANAGER, CASHIER
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@map("categories")
}

model Product {
  id             Int             @id @default(autoincrement())
  businessId     Int
  business       Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name           String
  sku            String?         @unique
  barcode        String?         @unique
  categoryId     Int
  category       Category        @relation(fields: [categoryId], references: [id])
  unit           String
  costPrice      Decimal         @db.Decimal(12, 2)
  sellingPrice   Decimal         @db.Decimal(12, 2)
  gstRate        Decimal         @default(5.00) @db.Decimal(5, 2)
  lowStockLevel  Decimal         @default(5.000) @db.Decimal(12, 3)
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  stockMovements StockMovement[]
  billItems      BillItem[]
  purchaseItems  PurchaseItem[]

  @@map("products")
}

model StockMovement {
  id        Int      @id @default(autoincrement())
  productId Int
  product   Product  @relation(fields: [productId], references: [id])
  type      String
  quantity  Decimal  @db.Decimal(12, 3)
  note      String?
  reference String?
  createdAt DateTime @default(now())

  @@map("stock_movements")
}

model Customer {
  id           Int                   @id @default(autoincrement())
  name         String
  phone        String                @unique
  address      String?
  creditLimit  Decimal               @default(10000.00) @db.Decimal(12, 2)
  currentDue   Decimal               @default(0.00) @db.Decimal(12, 2)
  createdAt    DateTime              @default(now())
  bills        Bill[]
  transactions CustomerTransaction[]

  @@map("customers")
}

model CustomerTransaction {
  id         Int      @id @default(autoincrement())
  customerId Int
  customer   Customer @relation(fields: [customerId], references: [id])
  amount     Decimal  @db.Decimal(12, 2)
  type       String
  reference  String?
  createdAt  DateTime @default(now())

  @@map("customer_transactions")
}

model Supplier {
  id           Int                   @id @default(autoincrement())
  name         String
  phone        String
  companyName  String?
  currentDue   Decimal               @default(0.00) @db.Decimal(12, 2) // Accounts Payable
  createdAt    DateTime              @default(now())
  purchases    Purchase[]
  transactions SupplierTransaction[]

  @@map("suppliers")
}

model Purchase {
  id            Int            @id @default(autoincrement())
  invoiceNumber String         @unique
  supplierId    Int
  supplier      Supplier       @relation(fields: [supplierId], references: [id])
  totalAmount   Decimal        @db.Decimal(12, 2)
  paymentType   String // CASH, UPI, CREDIT (Merchant Credit)
  createdAt     DateTime       @default(now())
  items         PurchaseItem[]

  @@map("purchases")
}

model PurchaseItem {
  id         Int      @id @default(autoincrement())
  purchaseId Int
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId  Int
  product    Product  @relation(fields: [productId], references: [id])
  quantity   Decimal  @db.Decimal(12, 3)
  costPrice  Decimal  @db.Decimal(12, 2)

  @@map("purchase_items")
}

model SupplierTransaction {
  id         Int      @id @default(autoincrement())
  supplierId Int
  supplier   Supplier @relation(fields: [supplierId], references: [id])
  amount     Decimal  @db.Decimal(12, 2)
  type       String // PURCHASE_CREDIT, PAYMENT_PAID
  reference  String?
  createdAt  DateTime @default(now())

  @@map("supplier_transactions")
}

model Bill {
  id            Int        @id @default(autoincrement())
  businessId    Int
  business      Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  billNumber    String     @unique
  customerId    Int?
  customer      Customer?  @relation(fields: [customerId], references: [id])
  totalAmount   Decimal    @db.Decimal(12, 2)
  taxAmount     Decimal    @default(0.00) @db.Decimal(12, 2)
  paymentMethod String
  createdAt     DateTime   @default(now())
  items         BillItem[]

  @@map("bills")
}

model BillItem {
  id        Int     @id @default(autoincrement())
  billId    Int
  bill      Bill    @relation(fields: [billId], references: [id], onDelete: Cascade)
  productId Int
  product   Product @relation(fields: [productId], references: [id])
  quantity  Decimal @db.Decimal(12, 3)
  price     Decimal @db.Decimal(12, 2)

  @@map("bill_items")
}

model Liability {
  id           Int      @id @default(autoincrement())
  lenderName   String
  totalAmount  Decimal  @db.Decimal(12, 2)
  outstanding  Decimal  @db.Decimal(12, 2)
  interestRate Decimal  @db.Decimal(5, 2)
  monthlyEMI   Decimal  @db.Decimal(12, 2)
  startDate    DateTime
  status       String   @default("ACTIVE")

  @@map("liabilities")
}

model Expense {
  id       Int      @id @default(autoincrement())
  category String
  amount   Decimal  @db.Decimal(12, 2)
  paidTo   String
  notes    String?
  date     DateTime @default(now())

  @@map("expenses")
}

model Staff {
  id            Int          @id @default(autoincrement())
  name          String
  phone         String
  role          String
  monthlySalary Decimal      @db.Decimal(12, 2)
  attendances   Attendance[]
  payrolls      Payroll[]

  @@map("staff")
}

model Attendance {
  id          Int      @id @default(autoincrement())
  staffId     Int
  staff       Staff    @relation(fields: [staffId], references: [id])
  date        DateTime @db.Date
  status      String
  overtimeHrs Decimal  @default(0.00) @db.Decimal(4, 2)

  @@map("attendances")
}

model Payroll {
  id          Int      @id @default(autoincrement())
  staffId     Int
  staff       Staff    @relation(fields: [staffId], references: [id])
  month       String
  baseSalary  Decimal  @db.Decimal(12, 2)
  deductions  Decimal  @default(0.00) @db.Decimal(12, 2)
  netPaid     Decimal  @db.Decimal(12, 2)
  paymentDate DateTime @default(now())

  @@map("payrolls")
}

model ShopSetting {
  id            Int      @id @default(autoincrement())
  businessId    Int      @unique
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  shopName      String   @default("My Grocery Shop")
  tagline       String?  @default("Fresh & Quality Essentials")
  phone         String?
  address       String?
  gstin         String?
  logoUrl       String?  @db.LongText
  receiptFooter String?  @default("Thank you for shopping with us!")
  updatedAt     DateTime @updatedAt

  @@map("shop_settings")
}

model Unit {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())

  @@map("units")
}

model Account {
  id        Int           @id @default(autoincrement())
  name      String        @unique
  type      String // ASSET, LIABILITY, INCOME, EXPENSE
  balance   Decimal       @default(0.00) @db.Decimal(12, 2)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  lines     JournalLine[]

  @@map("accounts")
}

model JournalEntry {
  id        Int           @id @default(autoincrement())
  reference String
  notes     String?
  createdAt DateTime      @default(now())
  lines     JournalLine[]

  @@map("journal_entries")
}

model JournalLine {
  id             Int          @id @default(autoincrement())
  journalEntryId Int
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId      Int
  account        Account      @relation(fields: [accountId], references: [id])
  debit          Decimal      @default(0.00) @db.Decimal(12, 2)
  credit         Decimal      @default(0.00) @db.Decimal(12, 2)

  @@map("journal_lines")
}
